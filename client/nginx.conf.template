# Rendered by the nginx image entrypoint (envsubst) into /etc/nginx/conf.d/default.conf.
server {
	listen ${PORT};
	server_name _;
	root /usr/share/nginx/html;
	index index.html;
	server_tokens off;
	client_max_body_size 10m;

	# Resolve the backend per request rather than once at startup, so nginx still
	# boots if the backend isn't up yet and follows it when its IP changes.
	resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

	location /v1/ {
		set $backend ${BACKEND_URL};
		proxy_pass $backend;
		proxy_http_version 1.1;
		# Host stays the backend's own name (nginx's default). Platforms that route
		# on Host (e.g. Azure Container Apps) need that; the original host goes here:
		proxy_set_header X-Forwarded-Host $host;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_read_timeout 120s;
	}

	location = /index.html {
		add_header Cache-Control "no-cache";
	}

	location / {
		try_files $uri $uri/ /index.html;
	}
}
